{
  "name": "subliminally-by-fthr",
  "version": "1.0.0",
  "private": true,
  "description": "Subliminally by FTHR \u2014 web site plus the Capacitor wrapper that builds the iOS and Android apps from it.",
  "scripts": {
    "test:rituals": "node scripts/ritual-state-test.js",
    "test:faith": "node scripts/faith-language-test.js",
    "test:checkout": "node scripts/checkout-session-test.mjs",
    "test:voice": "node scripts/voice-studio-test.mjs",
    "test:voice-routing": "node scripts/voice-routing-test.js",
    "test:ambience": "node scripts/ambience-test.js",
    "cap:sync": "node scripts/sync-web-assets.js && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "test:mix": "node scripts/mix-settings-test.cjs",
    "test:audio-editor": "node scripts/audio-editor-e2e.cjs",
    "test:frequency-layers": "node scripts/frequency-layers-test.cjs",
    "test:affirmations": "node scripts/affirmation-timeline-test.cjs",
    "test:layers-lyrics": "node scripts/layers-lyrics-e2e.cjs",
    "test:lifecycle": "node scripts/audio-lifecycle-test.cjs",
    "test:unit": "npm run test:rituals && npm run test:faith && npm run test:checkout && npm run test:mix && npm run test:frequency-layers && npm run test:affirmations && npm run test:lifecycle && npm run test:take-sync && npm run test:marketing-sync",
    "test:take-sync": "node scripts/take-sync-test.cjs",
    "test:own-voice-100": "node scripts/own-voice-100-e2e.cjs",
    "test:serenity-e2e": "node scripts/serenity-e2e.cjs",
    "test:saved-audio": "node scripts/saved-audio-e2e.cjs",
    "test:marketing-sync": "node scripts/marketing-sync-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@revenuecat/purchases-capacitor": "^13.5.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
